{
  "name": "schedex",
  "displayName": "Schedex",
  "description": "%extension.description%",
  "version": "1.1.0",
  "publisher": "IThlet",
  "repository": {
    "type": "git",
    "url": "https://github.com/stalin-777/schedex.git"
  },
  "funding": {
    "type": "custom",
    "url": "https://app.lava.top/ithlete?tabId=donate"
  },
  "homepage": "https://github.com/stalin-777/schedex#readme",
  "bugs": {
    "url": "https://github.com/stalin-777/schedex/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "openai",
    "scheduler",
    "scheduled prompts",
    "automation",
    "wsl"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "schedex.schedulePrompt",
        "title": "%command.schedule%",
        "category": "Schedex",
        "icon": "$(schedex-schedule-send)"
      },
      {
        "command": "schedex.manageScheduled",
        "title": "%command.manage%",
        "category": "Schedex"
      },
      {
        "command": "schedex.bindThreadFromClipboard",
        "title": "%command.bind%",
        "category": "Schedex"
      },
      {
        "command": "schedex.diagnoseUi",
        "title": "%command.diagnose%",
        "category": "Schedex"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "schedex.schedulePrompt",
          "when": "webviewId =~ /codex|chatgpt/i",
          "group": "1_modification@100"
        }
      ],
      "view/title": [
        {
          "command": "schedex.schedulePrompt",
          "when": "view =~ /codex|chatgpt/i",
          "group": "navigation@100"
        }
      ],
      "editor/title": [
        {
          "command": "schedex.schedulePrompt",
          "when": "activeCustomEditorId =~ /codex|chatgpt/i",
          "group": "navigation@100"
        }
      ]
    },
    "icons": {
      "schedex-schedule-send": {
        "description": "Schedule a Codex prompt",
        "default": {
          "fontPath": "./media/schedex-calendar-send.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "configuration": {
      "title": "Schedex",
      "properties": {
        "schedex.historyRetentionDays": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 3650,
          "description": "Automatically remove finished task history older than this many days on startup and daily. 0 keeps history until you clear it. Queued, running and unconfirmed tasks are retained.",
          "scope": "application"
        }
      }
    }
  },
  "icon": "media/schedex-logo.png",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check": "node scripts/check.js",
    "test": "node --test",
    "vsix": "vsce package --no-dependencies --out schedex.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0"
  },
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "overrides": {
    "minimatch@^10": "^11.0.5"
  }
}
